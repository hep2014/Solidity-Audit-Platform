DATABASE_URL=postgresql+psycopg://audit:audit@postgres:5432/audit
REDIS_URL=redis://redis:6379/0

STORAGE_DIR=/app/storage/uploads

SLITHER_IMAGE=solidity-audit-slither:latest
MYTHRIL_IMAGE=solidity-audit-mythril:latest
FOUNDRY_IMAGE=solidity-audit-foundry:latest
ECHIDNA_IMAGE=solidity-audit-echidna:latest

ANALYZER_TIMEOUT_SECONDS=180

CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
CELERY_TASK_TIME_LIMIT_SECONDS=960

MAX_UPLOAD_BYTES=26214400
MAX_EXTRACTED_BYTES=104857600
MAX_ARCHIVE_FILES=500
MAX_SOL_FILES=200